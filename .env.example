# Both keys are optional. Without them the app still works:
# shows and videos fall back to links out.

# Upcoming shows. Free key: https://developer.ticketmaster.com
TICKETMASTER_API_KEY=

# Music videos. Free key (YouTube Data API v3): https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# Set to 1 to run fully offline on fixture data.
SOUNDTHIS_MOCK=
